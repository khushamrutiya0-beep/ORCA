# ORCA Environment Variables

# LLM Provider (optional — ORCA works fully without this using deterministic fallback)
# If set, uses Google Gemini (gemini-2.0-flash) for conversational intelligence.
GOOGLE_GENERATIVE_AI_API_KEY=
# Legacy alias (still supported):
GEMINI_API_KEY=

# INCOIS PFZ Provider (Optional: Leave empty to use verified DEMO dataset)
INCOIS_API_KEY=
INCOIS_API_ENDPOINT=

# IMD Official Alert Provider (Optional: Leave empty until credentials available at api.imd.gov.in)
IMD_API_KEY=

# App Configuration
NEXT_PUBLIC_APP_NAME="ORCA Marine Intelligence"
NEXT_PUBLIC_DEFAULT_LAT=18.9220
NEXT_PUBLIC_DEFAULT_LON=72.8347

# CARTO Basemap Configuration (Optional override)
NEXT_PUBLIC_CARTO_API_KEY=cb1_2ckc_1_704793e311683de92976b6e7
NEXT_PUBLIC_CARTO_TILE_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?key=cb1_2ckc_1_704793e311683de92976b6e7
